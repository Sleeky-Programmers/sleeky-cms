# Copy to .env.local and fill in. Never commit real values.

# Public URL of the CMS (used in invite and password-reset links)
APP_URL=http://localhost:3000

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=
# Optional: only if your machine's DNS refuses mongodb+srv lookups (error "querySrv ECONNREFUSED")
# MONGODB_DNS_SERVERS=1.1.1.1,8.8.8.8

# Signs sessions. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# SMTP for invite and password-reset emails. Without these, development prints
# emails (with their links) to the terminal; production refuses to start sending.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
# Optional sender, e.g. "Sleeky CMS" <cms@sleekyprogrammers.com>
EMAIL_FROM=

# Cloudinary for article images (Cloudinary console > Settings > API Keys).
# Without these, image uploads are turned off.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: refresh the website as soon as an article is published or changed.
# WEBSITE_REVALIDATE_URL is the website's /api/revalidate address; the secret
# must match the website's REVALIDATE_SECRET (at least 16 characters).
WEBSITE_REVALIDATE_URL=
REVALIDATE_SECRET=
